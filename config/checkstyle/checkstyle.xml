<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
	Adapted from Checkstyle's own sun_checks.xml (the tool's standard baseline),
	trimmed to complement rather than duplicate the spring-javaformat formatter
	and to fit a Spring Boot codebase:
	  - Javadoc and file-header checks removed: this is an internal service, not
	    an OSS library with a mandated license header / public API docs.
	  - FileTabCharacter removed: spring-javaformat indents with tabs.
	  - Whitespace/layout checks removed: already enforced by the formatter
	    (`./gradlew checkFormat`); duplicating them here would just make the two
	    tools disagree.
	  - DesignForExtension removed: it forces overridable methods to be
	    final-or-documented, which fights Spring's proxy-based beans (e.g. @Transactional, @Async).
	  - HiddenField ignores constructor/setter parameters: Spring's standard
	    constructor-injection style (`this.foo = foo`) intentionally shadows
	    the field name.
-->
<module name="com.puppycrawl.tools.checkstyle.Checker">

	<property name="severity" value="error"/>
	<property name="fileExtensions" value="java"/>
	<!-- Matches spring-javaformat's own line-wrap budget: it counts each leading
	     indentation tab as a single column, not Checkstyle's historical default of
	     expanding a tab to 8 - without this, the two tools disagree about whether a
	     deeply-indented line is within the 120-column limit, contradicting the "don't
	     duplicate what the formatter already enforces" intent below. -->
	<property name="tabWidth" value="1"/>

	<module name="SuppressionFilter">
		<property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
	</module>

	<module name="NewlineAtEndOfFile"/>
	<module name="FileLength"/>
	<module name="LineLength">
		<property name="max" value="120"/>
		<!-- A fully-qualified import can't be wrapped across lines the way any other
		     Java statement can, so a long one is a false positive here, not a real
		     style issue. -->
		<property name="ignorePattern" value="^import "/>
	</module>

	<module name="RegexpSingleline">
		<property name="format" value="\s+$"/>
		<property name="minimum" value="0"/>
		<property name="maximum" value="0"/>
		<property name="message" value="Line has trailing spaces."/>
	</module>

	<module name="TreeWalker">

		<!-- Naming conventions -->
		<module name="ConstantName"/>
		<module name="LocalFinalVariableName"/>
		<module name="LocalVariableName"/>
		<module name="MemberName"/>
		<module name="MethodName"/>
		<module name="PackageName"/>
		<module name="ParameterName"/>
		<module name="StaticVariableName"/>
		<module name="TypeName"/>

		<!-- Imports -->
		<module name="AvoidStarImport"/>
		<module name="IllegalImport"/>
		<module name="RedundantImport"/>
		<module name="UnusedImports"/>

		<!-- Size violations -->
		<module name="MethodLength"/>
		<module name="ParameterNumber"/>

		<!-- Modifiers -->
		<module name="ModifierOrder"/>
		<module name="RedundantModifier"/>

		<!-- Blocks -->
		<module name="AvoidNestedBlocks"/>
		<module name="EmptyBlock"/>
		<module name="NeedBraces"/>

		<!-- Common coding problems -->
		<module name="EmptyStatement"/>
		<module name="EqualsHashCode"/>
		<module name="FallThrough"/>
		<module name="HiddenField">
			<property name="ignoreConstructorParameter" value="true"/>
			<property name="ignoreSetter" value="true"/>
		</module>
		<module name="IllegalInstantiation"/>
		<module name="InnerAssignment"/>
		<module name="MissingSwitchDefault"/>
		<module name="MultipleVariableDeclarations"/>
		<module name="OneStatementPerLine"/>
		<module name="SimplifyBooleanExpression"/>
		<module name="SimplifyBooleanReturn"/>

		<!-- Class design -->
		<module name="DeclarationOrder"/>
		<module name="FinalClass"/>
		<module name="HideUtilityClassConstructor"/>
		<module name="InterfaceIsType"/>
		<module name="VisibilityModifier"/>

		<!-- Miscellaneous -->
		<module name="ArrayTypeStyle"/>
		<module name="TodoComment">
			<property name="severity" value="info"/>
		</module>
		<module name="UpperEll"/>

	</module>
</module>
