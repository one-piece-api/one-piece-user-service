{
  "realm": "onepiece",
  "enabled": true,
  "editUsernameAllowed": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "host.testcontainers.internal",
    "port": "3025",
    "from": "test@onepiece.local",
    "auth": "false",
    "starttls": "false",
    "ssl": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full administrative access",
        "composite": true,
        "composites": {
          "client": {
            "onepiece-proxy": ["users:read", "users:invite", "roles:read", "roles:assign", "access:write", "audit:read"]
          }
        }
      },
      {
        "name": "EDITOR",
        "description": "Content editing permissions",
        "composite": true,
        "composites": {
          "client": {
            "onepiece-proxy": ["docs:read", "docs:write"]
          }
        }
      },
      {
        "name": "REVIEWER",
        "description": "Review and approval permissions",
        "composite": true,
        "composites": {
          "client": {
            "onepiece-proxy": ["docs:read", "docs:review"]
          }
        }
      }
    ],
    "client": {
      "onepiece-proxy": [
        { "name": "users:read", "description": "List and view crew members" },
        { "name": "users:invite", "description": "Invite a new crew member" },
        { "name": "roles:read", "description": "View the role/permission registry" },
        { "name": "roles:assign", "description": "Assign or revoke a crew member's roles" },
        { "name": "access:write", "description": "Revoke or reactivate a crew member's access" },
        { "name": "audit:read", "description": "Read the ship's log (audit trail)" },
        { "name": "docs:read", "description": "View documents" },
        { "name": "docs:review", "description": "Review documents" },
        { "name": "docs:write", "description": "Edit documents" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "test-client",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"]
    },
    {
      "clientId": "onepiece-proxy",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "test-proxy-client-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:4180/*"]
    },
    {
      "clientId": "user-service-admin",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "test-admin-client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-user-service-admin",
      "enabled": true,
      "serviceAccountClientId": "user-service-admin",
      "clientRoles": {
        "realm-management": ["view-realm", "view-users", "query-users", "manage-users", "view-events"]
      }
    },
    {
      "username": "luffy",
      "email": "luffy@onepiece.local",
      "firstName": "Monkey D.",
      "lastName": "Luffy",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "luffy-pass", "temporary": false }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "nami",
      "email": "nami@onepiece.local",
      "firstName": "Nami",
      "lastName": "Cat Burglar",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "nami-pass", "temporary": false }
      ],
      "realmRoles": ["EDITOR"]
    }
  ]
}
